ex:V117P2 a gx:Person ;
    gx:gender [ a gx:Gender ] .

ex:V117R1 a gx:Relationship ;
    gx:type gx:ParentChild ;
    gx:person1 ex:V117P2 ;
    gx:person2 ex:V117P1 .


######################################################################
# V118: Parent=Typed; Gender=Unknown4
######################################################################
ex:V118P1 a gx:Person ;
    gx:gender [ a gx:Gender ; gx:type gx:Male ] .

# gx:type exists, but the gender node is not typed as gx:Gender
ex:V118P2 a gx:Person ;
    gx:gender [ gx:type gx:Male ] .

ex:V118R1 a gx:Relationship ;
    gx:type gx:ParentChild ;
    gx:person1 ex:V118P2 ;
    gx:person2 ex:V118P1 .


