    gx:type gx:ParentChild ;
    gx:person1 ex:V202P2 ;
    gx:person2 ex:V202P1 .

# ex:V202P3 is Untyped (has some properties but no rdf:type)
ex:V202P3 gx:birthDate "1900-01-01"^^xsd:date .

ex:V202R2 a gx:Relationship ;
    gx:type gx:ParentChild ;
    gx:person1 ex:V202P3 ;
    gx:person2 ex:V202P1 .

