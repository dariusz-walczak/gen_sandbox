from _typeshed import Incomplete
from singledispatch import singledispatch
from typing import NamedTuple

__all__ = ['load', 'loads', 'dump', 'dumps', 'parse', 'car', 'cdr', 'Symbol', 'String', 'Quoted', 'Brackets', 'Parens']

unicode = str

def load(filelike, **kwds): ...
def loads(string, **kwds): ...
def dump(obj, filelike, **kwds) -> None: ...
def dumps(obj, **kwds): ...
def car(obj): ...
def cdr(obj): ...

class String(unicode):
    def __eq__(self, other): ...
    def __ne__(self, other): ...
    def __hash__(self): ...
    @classmethod
    def quote(cls, string): ...
    @classmethod
    def unquote(cls, string): ...
    def value(self): ...

class Symbol(String): ...
class Quoted(NamedTuple('Quoted', [('x', Incomplete)])): ...

class Delimiters(NamedTuple('Delimiters', [('I', Incomplete)])):
    def __new__(cls, *args): ...
    @staticmethod
    def from_opener(opener, val): ...
    @staticmethod
    def get_brackets(): ...

class Brackets(Delimiters):
    opener: Incomplete
    closer: Incomplete

class Parens(Delimiters):
    opener: Incomplete
    closer: Incomplete

class ExpectClosingBracket(Exception):
    def __init__(self, got, expect) -> None: ...

class ExpectNothing(Exception):
    def __init__(self, got) -> None: ...

class ExpectSExp(Exception):
    def __init__(self, pos) -> None: ...

class Parser:
    brackets: dict
    closing_brackets: set
    string: Incomplete
    nil: Incomplete
    true: Incomplete
    false: Incomplete
    string_to: Incomplete
    line_comment: Incomplete
    quote_or_escape_re: Incomplete
    atom_end: Incomplete
    atom_end_or_escape_re: Incomplete
    def __init__(self, string, string_to=None, nil: str = 'nil', true: str = 't', false=None, line_comment: str = ';') -> None: ...
    def parse_str(self, i): ...
    def parse_atom(self, i): ...
    def atom(self, token): ...
    def parse_sexp(self, i): ...
    def parse(self): ...

def parse(string, **kwds): ...
